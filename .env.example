# ============================================================
# CONFIGURACIÓN DEL GIMNASIO CRM - EJEMPLO
# Copia este archivo como .env y completa los valores reales
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=gimnasio
DB_PORT=3306

# Información de la aplicación
APP_TITLE=Gym CRM API
APP_VERSION=1.0.0
APP_DESCRIPTION=API CRM para gimnasio con autenticación JWT

# JWT - Tokens de autenticación (usa una clave larga y aleatoria en producción)
JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA_EN_PRODUCCION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
